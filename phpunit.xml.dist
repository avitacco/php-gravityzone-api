<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/13.0/phpunit.xsd" colors="true" bootstrap="vendor/autoload.php" cacheDirectory=".phpunit.cache">
  <php>
    <ini name="xdebug.mode" value="coverage"/>
  </php>
  <coverage>
    <report>
      <html outputDirectory="./coverage"/>
    </report>
  </coverage>
  <testsuites>
    <testsuite name="Indiana University's GravityZone APT test suite">
      <directory>./test</directory>
    </testsuite>
  </testsuites>
  <logging/>
  <source>
    <include>
      <directory suffix=".php">./src</directory>
    </include>
  </source>
</phpunit>
